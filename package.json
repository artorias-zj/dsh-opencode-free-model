    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "opencode",
    "opencode-zen",
    "free-model",
    "llm-provider"
  ],
  "license": "MIT",
  "author": "artorias-zj",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artorias-zj/dsh-opencode-free-model.git"
  },
  "homepage": "https://github.com/artorias-zj/dsh-opencode-free-model#readme",
  "bugs": {
    "url": "https://github.com/artorias-zj/dsh-opencode-free-model/issues"
  },
  "engines": {
    "node": "^22.15.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
